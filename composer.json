{
    "name": "avathar/bbaccounts",
    "type": "phpbb-extension",
    "description": "Double-entry accounting for phpBB 3.3. Source-agnostic ledger service plus admin UI; designed as a point-storage foundation for other phpBB extensions.",
    "homepage": "https://github.com/avatharbe/bbAccounts",
    "version": "1.3.2-alpha",
    "time": "2026-05-10",
    "keywords": ["phpbb", "extension", "accounting", "ledger", "double-entry"],
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Andreas Vandenberghe",
            "homepage": "https://www.avathar.be/forum",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-bcmath": "*",
        "composer/installers": "~1.0"
    },
    "require-dev": {
        "phpbb/epv": "dev-master",
        "phpunit/phpunit": "^9.6"
    },
    "extra": {
        "display-name": "bbAccounts",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<3.4.0@dev"
        }
    }
}
